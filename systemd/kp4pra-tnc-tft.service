[Unit]
Description=KP4PRA TNC - Mini PiTFT 1.3" status display (Config: TFT Display auto/on/off)
After=network-online.target bluetooth.target direwolf.service
PartOf=kp4pra-tnc.target

[Service]
Type=simple
User=kp4pra-tnc
# System python3 + apt packages (python3-pil, python3-numpy, python3-spidev,
# python3-libgpiod, python3-yaml) - installed by scripts/setup-tft.sh.
# Group access (gpio, spi on a Pi, systemd-journal for the Dire Wolf log)
# comes from the user's memberships; none are listed here so a missing
# group can never stop the unit (status=216/GROUP).
Environment=PYTHONPATH=/opt/kp4pra-tnc/src
Environment=KP4PRA_CONFIG=/rw/kp4pra-tnc/config.yaml
ExecStart=/usr/bin/python3 -m tft.main
Restart=on-failure
RestartSec=10

[Install]
WantedBy=kp4pra-tnc.target
